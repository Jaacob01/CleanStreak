{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI 后端",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/fastapi_server",
      "envFile": "${workspaceFolder}/fastapi_server/.env",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
