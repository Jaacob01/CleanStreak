# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cleanstreak

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
SECRET_KEY=change-me-to-a-random-secret

# 应用
APP_PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ─── Docker 宿主机对外端口（仅 docker compose 时生效）───
DB_EXPOSE_PORT=5432
REDIS_EXPOSE_PORT=6379
APP_EXPOSE_PORT=8000

# ─── Docker 完整部署时，把 DB_HOST/REDIS_HOST 改为容器服务名 ───
# DB_HOST=db
# REDIS_HOST=redis
